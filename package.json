{
  "name": "fit4110_lab03_postman_mock_testing",
  "version": "0.3.0",
  "private": true,
  "description": "FIT4110 Lab 03 - Postman, Mock Server, Contract Testing, Newman CI",

"scripts": {
  "mock:iot": "prism mock contracts/analytics.openapi.yaml --port 4010 --host 0.0.0.0",
  "mock:vision": "prism mock contracts/ai-vision.openapi.yaml --port 4011 --host 0.0.0.0",
  "mock:analytics": "prism mock contracts/analytics.openapi.yaml --port 4010 --host 0.0.0.0",

  "lint:contracts": "spectral lint contracts/*.yaml --fail-severity error",

  "test:mock": "newman run postman/collections/analytics_access_core.postman_collection.json -e postman/environments/analytics_mock.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman-report.xml",

  "test:analytics": "newman run postman/collections/analytics_access_core.postman_collection.json -e postman/environments/analytics_mock.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman-report-analytics.xml",

  "test:iot": "newman run postman/collections/FIT4110_lab03_iot_ingestion.postman_collection.json -e postman/environments/FIT4110_lab03_mock.postman_environment.json --reporters cli,junit --reporter-junit-export reports/newman-report-iot.xml"
}
,
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.15.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^7.2.0"
  }
}
