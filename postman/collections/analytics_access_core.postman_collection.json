{
  "info": {
    "_postman_id": "analytics-access-core-collection",
    "name": "Analytics Access + Core Lab03 Tests",
    "description": "Postman collection for A5 Analytics Lab03. This collection tests Analytics APIs for Access Gate and Core Business events using Prism mock server or local Analytics service.",
